# Server-side only. Never ship these in the .ehpk (Even QA rejects it; anyone can unpack the bundle).
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787

# Telegram bot (@BotFather). Enable Secretary Mode for the bot in @BotFather (Bot Settings ▸ Secretary Mode), then add it under Telegram ▸ Settings ▸ Chat Automation.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Set to "test" to use the Telegram test environment (https://api.telegram.org/bot<token>/test/METHOD)
TELEGRAM_ENV=prod
TELEGRAM_WEBHOOK_SECRET=

# Speech-to-text + speaker diarization
DEEPGRAM_API_KEY=

# Commitment extraction. FREE: Groq (console.groq.com, no card). Optional paid alternative: Anthropic.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=

# Optional: TON testnet proof stamp
TONCENTER_API_KEY=
TON_STAMP_MNEMONIC=

DATABASE_PATH=./data/dextra.db
# Production: a free Turso database (turso.tech), so data survives restarts on Render's free plan.
DATABASE_URL=
DATABASE_AUTH_TOKEN=
